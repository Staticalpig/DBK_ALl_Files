@using Org.BouncyCastle.Asn1.Ocsp
@model c24elipe_PuckoApp.Models.Raport.ViewRapportModel;

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Raports</h2>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}


<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>Datum</th>
        <th>Nr</th>
        <th>Typ</th>
        <th>Agent</th>
        <th>Ledare</th>
        <th>Incident</th>
        <th>Inspect</th>
    </tr>
    </thead>
    @if (Model.Reports.Count > 0)
    {
        <tbody>
        @foreach (var repport in Model.Reports)
        {
            <tr>
                <td>@repport.Datum</td>
                <td>@repport.Nr</td>
                <td>@repport.RapportTyp</td>
                <td>@repport.Användarnamn</td>
                <td>@repport.Incidentledare</td>
                <td>
                    <a href="@Url.Action("Index", "Incident", new { IncidentNamn = repport.Incident_Namn, IncidentNr = repport.Incident_NR})" 
                       class="text-decoration-none text-dark">@repport.Incident_Namn- @repport.Incident_NR</a>
                </td>
                <td>
                    @if (Context.Request.Query["RapportNamn"] == repport.Datum.ToString("o")
                         && Context.Request.Query["RapportNR"] == repport.Nr.ToString())
                    {
                        <a href="@Url.Action("Index", "Rapport", new {})"
                           class="btn-dark">Deselect</a>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Rapport", new { RapportNamn = repport.Datum.ToString("o"), RapportNR = repport.Nr })"
                           class="btn-dark">Select</a>
                    }
                </td>
            </tr>
                
        }
            
        </tbody>
    }
</table>

@if(Context.Request.Query["RapportNamn"].Count > 0 && Context.Request.Query["RapportNR"].Count > 0)
{
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>Rapport</th>
            <th>Radder</th>
            <th>Commentary</th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td>
                <table>
                    <tr class="border-black border-2">
                        <td class="font-weight-bold border-0 m-1">Datum</td>
                        <td class="m-1 border-black border-1 m-1">@Model.SelectedReport.Datum</td>
                    </tr>
                    <tr class="border-black border-2">
                        <td class="font-weight-bold border-0 m-1">Nr</td>
                        <td class="m-1 border-black border-1 m-1">@Model.SelectedReport.Nr</td>
                    </tr>
                    <tr class="border-black border-2">
                        <td class="font-weight-bold border-0 m-1">Agent</td>
                        <td class="m-1 border-black border-1 m-1">@Model.SelectedReport.Användarnamn</td>
                    </tr>
                    <tr class="border-black border-2">
                        <td class="font-weight-bold border-0 m-1">Incident ledare</td>
                        <td class="m-1 border-black border-1 m-1">@Model.SelectedReport.Incidentledare</td>
                    </tr>
                    <tr class="border-black border-2">
                        <td class="font-weight-bold border-0 m-1">Slut Datum</td>
                        <td class="m-1 border-black border-1 m-1">@Model.SelectedReport.Slutdatum</td>
                    </tr>
                    <tr class="border-black border-2">
                        <td colspan="2">
                            <a href="@Url.Action("Index", "Incident", new { IncidentNamn = @Model.SelectedReport.Incident_Namn, 
                                         IncidentNr = @Model.SelectedReport.Incident_NR})" 
                               class="text-decoration-none text-dark">@Model.SelectedReport.Incident_Namn - @Model.SelectedReport.Incident_NR</a>
                        </td>
                    </tr>
                </table>
            </td>
            <td>
                <div>
                    @if (Context.Session.GetString("Role") != "agent")
                    {
                        <form method="POST" asp-action="AddNewRad" asp-controller="Rapport" class="border-1 border-black mb-2 ">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RapportDatum" value="@Model.SelectedReport.Datum.ToString("o")"/>
                            <input type="hidden" name="RapportNr" value="@Model.SelectedReport.Nr"/>

                            <textarea name="RapportRaddText">Skapa en radd</textarea>
                            <button type="submit" class="btn btn-primary m-2">Add</button>
                        </form>
                    }
                    <table>
                        @foreach (var rad in Model.SelectedRadder)
                        {
                            <tr>
                                <td>
                                    <form method="post" asp-action="EnableRadEditing" asp-controller="Rapport">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="RapportDatum" value="@Model.SelectedReport.Datum" />
                                        <input type="hidden" name="RapportNr" value="@Model.SelectedReport.Nr" />
                                        <input type="hidden" name="RadId" value="@rad.Nr" />
                                        <button type="submit" name="RadText" value="@rad.Text" class="btn btn-link text-left">
                                            @rad.Text
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </table>
                </div>
            </td>
            <td>
                <div>
                    @foreach (var comment in Model.SelectedComments)
                    {
                        <div class="border-black border-1 mb-2 p-1">
                            <p>@comment.Text</p>
                            <small>By: @comment.GjordAvNamn at @comment.Rapport_Datum</small>
                        </div>
                    }
                    @if (Context.Session.GetString("Role") != "agent")
                    {
                        <form method="POST" asp-action="AddNewComment" asp-controller="Rapport" class="border-1 border-black p-2 ">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RapportDatum" value="@Model.SelectedReport.Datum.ToString("o")"/>
                            <input type="hidden" name="RapportNr" value="@Model.SelectedReport.Nr"/>

                            <textarea name="CommentText" class="w-100 mb-2" rows="4">Add a comment</textarea>
                            <button type="submit" class="btn btn-primary">Add Comment</button>
                        </form>
                    }
                </div>
            </td>
        </tr>
    </tbody>
        
    </table>
}


@if (ViewBag.EnableRadEditing == true && ViewBag.SelectedRadId != null)
{
    <div class="border-black border-2 p-2">
        <h3>Selected Rad</h3>
        <form method="post" asp-action="UpdateRad" asp-controller="Rapport">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RapportDatum" value="@ViewBag.RapportDatum" />
            <input type="hidden" name="RapportNr" value="@ViewBag.RapportNr" />
            <input type="hidden" name="RadId" value="@ViewBag.SelectedRadId" />
            
            <textarea name="RadText" class="w-100 mb-2" rows="4">@ViewBag.SelectedRadText</textarea>
            
            <label for="Delete">Delete the rad: </label>
            <input type="checkbox" id="Delete" name="DeleteRad" value="true" />
            
            <button class="btn btn-primary" type="submit">Update Rad</button>
        </form>
    </div>
}
